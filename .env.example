NUXT_PUBLIC_INSFORGE_URL=
NUXT_PUBLIC_INSFORGE_ANON_KEY=
# Server-only (nunca NUXT_PUBLIC_*): admin key de InsForge para las routes.
NUXT_INSFORGE_API_KEY=
# Opt-in: API oficial de Google (server-only, nunca NUXT_PUBLIC_*).
NUXT_TRANSLATE_API_KEY=
# Opt-in: email válido para cuota MyMemory x10 (5k -> 50k chars/día).
NUXT_MYMEMORY_EMAIL=
# Fallback confiable desde IPs de datacenter (gateway de InsForge).
# En Cloudflare el secret se llama OPENROUTER_API_KEY; en local Nuxt mapea
# NUXT_OPENROUTER_API_KEY.
NUXT_OPENROUTER_API_KEY=
