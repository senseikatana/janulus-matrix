# Opcional y apagado por defecto. Sin esta key la app usa la cadena 100% gratuita.
# La key vive SOLO en el server (runtimeConfig privada). Nunca usar NUXT_PUBLIC_ para secrets.
NUXT_TRANSLATE_API_KEY=

# InsForge (Fase 3: DB + Auth). Públicas porque van al cliente Nuxt.
# Se obtienen con: npx -y @insforge/cli link + secrets get ANON_KEY
NUXT_PUBLIC_INSFORGE_URL=
NUXT_PUBLIC_INSFORGE_ANON_KEY=
