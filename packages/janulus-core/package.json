{
  "name": "janulus-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for Janulus Matrix: ES/PT/EN/CA/GL types, offline dictionary, approximate IPA phonetics and a free-first translation provider chain.",
  "license": "MIT",
  "author": "Sergio Jurado (senseikatana)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senseikatana/janulus-matrix.git",
    "directory": "packages/janulus-core"
  },
  "homepage": "https://github.com/senseikatana/janulus-matrix#readme",
  "bugs": "https://github.com/senseikatana/janulus-matrix/issues",
  "keywords": [
    "translation",
    "dictionary",
    "ipa",
    "phonetics",
    "portuguese",
    "spanish",
    "flashcards",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
